# SkillBridge Environment Variables

# -------------------------------------------------------------
# 1. Supabase Backend (Database, Auth, Row Level Security)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# -------------------------------------------------------------
# 2. Razorpay Payment Gateway (Optional)
# If omitted or left empty, SkillBridge uses the built-in Sandbox simulator.
# -------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyid

# -------------------------------------------------------------
# 3. AI Copilot / Resume Parser (Optional)
# Options: 'fallback' (deterministic rule engine), 'gemini', 'openai'
# -------------------------------------------------------------
VITE_AI_PROVIDER=fallback
VITE_AI_API_KEY=
